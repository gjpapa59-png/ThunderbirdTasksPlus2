{
  "manifest_version": 2,
  "name": "Thunderbird Aufgaben um 2 Tage, Wochen, auf Ultimo aufschieben",
  "version": "1.0.1",
  "applications": {
    "gecko": {
      "id": "postpone-2days@local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "calendar_menu_experiment": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "implementation.js",
        "paths": [["calendar_menu_experiment"]]
      }
    }
  },
  "permissions": []
}


